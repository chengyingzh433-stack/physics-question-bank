{
  "name": "physics-question-bank",
  "version": "1.1.0-beta.7",
  "description": "物理教师题库管理系统",
  "main": "./out/main/index.js",
  "author": "cyz",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --config electron-builder.yml",
    "dist:mac": "npm run rebuild && npm run build && electron-builder --config electron-builder.yml --mac --publish never",
    "test:packaged": "node scripts/test-packaged-app.mjs",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "rebuild": "install-electron && electron-rebuild -f -w better-sqlite3",
    "test": "vitest run",
    "test:bank-ui": "node scripts/run-bank-ui-smoke.mjs",
    "test:chapters-ui": "node scripts/run-chapter-ui-smoke.mjs",
    "test:answers-ui": "node scripts/run-answer-ui-smoke.mjs",
    "release:checksums": "node scripts/write-release-checksums.mjs"
  },
  "dependencies": {
    "@mantine/core": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@mantine/modals": "^7.17.8",
    "@mantine/notifications": "^7.17.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tabler/icons-react": "^3.44.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "better-sqlite3": "13.0.3",
    "docx": "9.14.0",
    "fflate": "0.8.3",
    "htmlparser2": "10.0.0",
    "mathlive": "0.111.1",
    "mathml2omml": "0.5.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pptxgenjs": "^3.12.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "saxes": "6.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@electron/rebuild": "4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^2.0.5"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "0.19.1"
    }
  }
}
